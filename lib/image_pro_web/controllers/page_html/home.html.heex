<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Image Processing</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* CSS Reset & Variables */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --border-color: #e2e8f0;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
      --shadow-md: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
      --shadow-hover: 0 20px 30px -10px rgba(15, 23, 42, 0.12);
      --radius-lg: 16px;
      --radius-md: 10px;
      --radius-sm: 6px;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem 1.5rem;
      line-height: 1.5;
    }

    /* Container */
    .container {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
    }

    /* Header Section */
    .header {
      text-align: center;
      margin-bottom: 3.5rem;
    }

    .badge {
      font-size: 0.9125rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--primary);
      background-color: #eff6ff;
      border: 1px solid #dbeafe;
      padding: 1rem 1.85rem;
      border-radius: 9999px;
      margin-bottom: 1rem;
     
    }

    .header h1 {
      font-size: 2.75rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--text-main);
      margin-bottom: 0.75rem;
    }

    .header p {
      font-size: 1.125rem;
      color: var(--text-muted);
      max-w: 540px;
      margin: 0 auto;
    }

    /* Cards Grid */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    /* Individual Card */
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 2rem;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-sm);
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
      position: relative;
    }

    .card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
      border-color: #cbd5e1;
    }

    /* Card Icon Area */
    .icon-wrapper {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
    }

    .icon-wrapper svg {
      width: 26px;
      height: 26px;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
    }

    /* Icon Theme Accents */
    .card-1 .icon-wrapper {
      background-color: #f0fdf4;
      color: #16a34a;
    }
    .card-2 .icon-wrapper {
      background-color: #eff6ff;
      color: #2563eb;
    }
    .card-3 .icon-wrapper {
      background-color: #faf5ff;
      color: #9333ea;
    }

    /* Card Content */
    .card h2 {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.6rem;
      color: var(--text-main);
    }

    .card p {
      font-size: 0.9375rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 1.5rem;
      flex-grow: 1;
    }

    /* Features Tag List */
    .feature-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }

    .tag {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text-muted);
      background-color: #f1f5f9;
      padding: 0.25rem 0.6rem;
      border-radius: var(--radius-sm);
    }

    /* Action Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.75rem 1.25rem;
      font-size: 0.9375rem;
      font-weight: 600;
      font-family: inherit;
      color: #ffffff;
      background-color: var(--text-main);
      border: 1px solid transparent;
      border-radius: var(--radius-md);
      cursor: pointer;
      text-decoration: none;
      transition: background-color 0.2s ease, transform 0.15s ease;
    }

    .btn:hover {
      background-color: var(--primary);
    }

    .btn:active {
      transform: scale(0.99);
    }

    .btn svg {
      width: 16px;
      height: 16px;
      stroke-width: 2.5;
      stroke: currentColor;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform 0.2s ease;
    }

    .btn:hover svg {
      transform: translateX(3px);
    }

    /* Responsive Adjustments */
    @media (max-width: 960px) {
      .cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      body {
        padding: 2.5rem 1rem;
      }

      .header h1 {
        font-size: 2.125rem;
      }

      .header p {
        font-size: 1rem;
      }

      .cards-grid {
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Header -->
    <header class="header">
      <span class="badge">Image Processing</span>
      <h1>Every tool you need to edit images in one place</h1>
      <p>Process, convert, compress, and edit your photos.</p>
    </header>

    <!-- 3 Cards -->
    <main class="cards-grid">
      
      <!-- Card 1: Filters & Effects -->
      <article class="card card-1">
        <div class="icon-wrapper">
          <i class="fa-solid fa-rotate"></i>    
        </div>
        <h2>Rotate Image</h2>
        <p>Rotate portrait or landscape images by 90°, 180°, or 270°.</p>
        
        <div class="feature-list">
         
             <span class="tag">Resize</span>
          <span class="tag">Rotate</span>
          <span class="tag">Perspective</span>
          <span class="tag">Flip</span>
        </div>
        <.link navigate={~p"/process/rotate"}>
        <button class="btn" type="button">
          Transform
          <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        </.link>
      </article>

      <!-- Card 2: Crop & Transform -->
      <article class="card card-2">
        <div class="icon-wrapper">
        <i class="fa-solid fa-circle-half-stroke"></i>
        </div>
        <h2>Invert Colors</h2>
        <p>
Invert image colors to create negative effects, reverse dark mode photos, or inspect photographic negatives.</p>
        
        <div class="feature-list">
           <span class="tag">Grayscale</span>
          <span class="tag">Blur</span>
          <span class="tag">Brightness</span>
          <span class="tag">Contrast</span>
        </div>
        <.link navigate={~p"/process/invert"}>
       <button class="btn" type="button">
          Apply Filters
          <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        </.link>
      </article>

      <!-- Card 3: AI Enhancement -->
      <article class="card card-3">
        <div class="icon-wrapper">
          <i class="fa-solid fa-minimize"></i>
        </div>
        <h2>Compress / Convert JPG</h2>
        <p>
Convert photos to JPG format with custom compression levels (High, Medium, Low) for optimized web sizing.</p>
        
        <div class="feature-list">
          <span class="tag">Upscaling</span>
          <span class="tag">Downscaling</span>
          <span class="tag">Coverting</span>


        </div>
        <.link navigate={~p"/process/compress"}>
        <button class="btn" type="button">
          Enhance
          <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        </.link>
      </article>

    </main>
  </div>
<footer style="margin-top: 3rem; text-align: center; color: var(--text-muted); font-size: 0.875rem;">
        <div >
                © 2026 ImagePro Created by Abivarna M.
            </div>
    </footer>

</body>
</html>